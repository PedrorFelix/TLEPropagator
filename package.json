{
  "name": "tlepropagator",
  "version": "1.0.0",
  "description": "a tle propagation view",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "backend": "cd backend && python manage.py runserver",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently -k -p \"[{name}]\" -c \"blue.bold,magenta.bold\" -n \"DJANGO,REACT\" \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
